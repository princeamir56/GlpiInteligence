# GLPI REST API connection
# Path depends on the GLPI major version:
#   GLPI 9.x / 10.x -> https://glpi.your-company.tld/apirest.php
#   GLPI 11.x       -> https://glpi.your-company.tld/api.php/v1
GLPI_BASE_URL=http://127.0.0.1:8080/api.php/v1
# Containers resolve 127.0.0.1 to themselves, so when GLPI runs on the Docker
# host the compose services need it by a different name. Leave unset to accept
# the compose default (http://host.docker.internal:8080/api.php/v1).
# GLPI_BASE_URL_CONTAINER=http://host.docker.internal:8080/api.php/v1
GLPI_APP_TOKEN=replace-with-app-token-from-glpi-api-clients
GLPI_USER_TOKEN=replace-with-user-personal-token-from-user-preferences

# Optional tuning
GLPI_PAGE_SIZE=100
GLPI_TIMEOUT=30
GLPI_MAX_RETRIES=3
GLPI_RETRY_BACKOFF=1.5
GLPI_VERIFY_SSL=true

# ---- Layer 2 / 3 — Postgres warehouse (reused by the ML engine) ----
# In docker-compose this is set to the internal service URL; set it here only
# when running the ML engine outside the compose network.
# POSTGRES_URL=postgresql+psycopg2://glpi:glpi@localhost:5432/glpi_dw

# ---- Layer 3 — ML engine ----
# MLflow tracking. A DB backend is REQUIRED for the model registry / Production
# stage — SQLite needs no extra service. (A plain file:./mlruns store cannot
# register models.) Point at a remote server URL if you have one.
# These are the LOCAL (non-Docker) values. Under docker-compose they are
# overridden to the shared mlruns volume:
#   sqlite:////opt/airflow/mlruns/mlflow.db  /  file:/opt/airflow/mlruns/artifacts
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts
# Where CamemBERT/sentence-transformers weights are cached after first download.
ML_MODEL_CACHE_DIR=./.model_cache
# Cold-start guard: skip training below this many ticket rows.
ML_COLD_START_MIN_ROWS=100
# Optional overrides
# ML_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# ML_SPACY_MODEL=fr_core_news_sm
# ML_TOP_N_CATEGORIES=10
# ML_KMEANS_K=10

# ---- Layer 4 — API backend (FastAPI) ----
# Reuses POSTGRES_URL and REDIS_URL above. The API coerces the Postgres URL to the
# async asyncpg driver automatically (postgresql+asyncpg://...).
# JWT signing secret — MUST be overridden in production with a long random value.
API_JWT_SECRET=change-me-in-prod
API_ACCESS_TOKEN_TTL_MIN=30
API_REFRESH_TOKEN_TTL_DAYS=7
# Comma-separated allowed CORS origins. Angular dev server default below.
API_ALLOWED_ORIGINS=http://localhost:4200
# Cache TTLs (seconds): overview 60s, heavy endpoints (sites/techniciens) 5 min.
API_CACHE_TTL_OVERVIEW=60
API_CACHE_TTL_HEAVY=300
# Rate limits (slowapi syntax). Anonymous by IP, authenticated by token.
API_RATE_LIMIT_ANON=100/minute
API_RATE_LIMIT_AUTH=300/minute
# WebSocket alert broadcaster: seconds between polls of the recommendations table.
API_ALERT_POLL_SECONDS=10
